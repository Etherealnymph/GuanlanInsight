<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.InsightSpace.Base" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="Theme.InsightSpace" parent="Theme.InsightSpace.Base" />

    <style name="Widget.Guanlan.IconButton" parent="">
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:tint">@color/text_primary</item>
    </style>

    <style name="Widget.Guanlan.PrimaryButton" parent="">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/button_text_dark</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/button_text_dark</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.Guanlan.SecondaryButton" parent="">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.Guanlan.TabLabel" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
